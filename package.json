{
  "name": "uni-scraper",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/getSyllabus.js",
    "build": "tsc",
    "serve": "pnpm run build && pnpm run start",
    "postinstall": "npm run build",
    "conv": "npm run build && node dist/convo",
    "dev": "pnpm run build & nodemon ./dist/scrapatore.js",
    "cat": "nodemon ./dist/stregatto.js",
    "clean": "npm run build & node ./dist/clean_json.js",
    "summary": "pnpm run build && node dist/summary.js",
    "exam": "pnpm run build && node dist/getExams.js",
    "urls": "pnpm run build && node dist/getUrls.js",
    "status": "pnpm run build && node dist/status.js",
    "courses": "pnpm run build && node dist/unibs/01_getCourses.js",
    "examurls": "pnpm run build && node dist/02_getExamsUrls.js",
    "syllabus": "pnpm run build && node dist/03_getSyllabus.js",
    "idtoname": "pnpm run build && node dist/course_id_to_name.js",
    "agentic:full": "pnpm run build && node dist/src/agentic_magic/scripts/run-full-pipeline.js",
    "agentic:courses": "pnpm run build && node dist/src/agentic_magic/scripts/discover-courses.js",
    "agentic:exams": "pnpm run build && node dist/src/agentic_magic/scripts/extract-exams.js",
    "agentic:scrape-details": "pnpm run build && node dist/src/agentic_magic/scripts/scrape-exam-details.js",
    "agentic:validate": "pnpm run build && node dist/src/agentic_magic/scripts/validate-data.js",
    "agentic:retry": "pnpm run build && node dist/src/agentic_magic/scripts/retry-failed.js",
    "agentic:rescrape": "pnpm run build && node dist/src/agentic_magic/scripts/rescrape-items.js",
    "agentic:visualize-datacourses": "pnpm run build && node dist/src/agentic_magic/scripts/generate-datacourses-visualization.js",
    "detailed-report": "pnpm run build && node dist/scripts/generate-detailed-report.js",
    "simple:full": "pnpm run build && node dist/src/simple_pipeline/run-pipeline.js",
    "simple:step1": "pnpm run build && node dist/src/simple_pipeline/run-pipeline.js step1",
    "simple:step2": "pnpm run build && node dist/src/simple_pipeline/run-pipeline.js step2",
    "simple:test": "pnpm run build && node dist/src/simple_pipeline/test-setup.js",
    "agentic:validate-improved": "pnpm run build && node dist/src/agentic_magic/scripts/validate-improved-pipeline.js",
    "agentic:check-output": "pnpm run build && node dist/src/agentic_magic/scripts/validate-improved-pipeline.js --check-output",
    "agentic:visualize": "pnpm run build && node dist/src/agentic_magic/scripts/generate-datacourses-visualization.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "nodemon": "^3.1.4",
    "openai": "^4.102.0",
    "puppeteer": "^22.12.1",
    "ts-node": "^10.9.2",
    "zod": "^3.25.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  }
}
